<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_event_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:background="@drawable/widget_card_background">

    <LinearLayout
        android:id="@+id/next_event_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/next_event_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="NDot57"
            android:text="NEXT"
            android:textColor="@color/widget_accent"
            android:textSize="@dimen/widget_text_label" />
        <TextView
            android:id="@+id/next_event_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:fontFamily="NDot57"
            android:text="Design review"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_text_title"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/widget_text_body"
            android:autoSizeMaxTextSize="@dimen/widget_text_title"
            android:autoSizeStepGranularity="@dimen/widget_text_autosize_step"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/next_event_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="NDot57"
            android:text="14:30 · starts in 42m"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="@dimen/widget_text_label"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/next_event_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:fontFamily="NDot57"
        android:text="NO UPCOMING EVENTS"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="@dimen/widget_text_body"
        android:visibility="gone" />
</FrameLayout>
