<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:clipToOutline="true"
    android:background="@drawable/widget_card_background">

    <LinearLayout
        android:id="@+id/quick_tasks_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/quick_tasks_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="TODAY"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_text_title"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/quick_tasks_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="2/4"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="@dimen/widget_text_label" />
    </LinearLayout>

    <TextView
        android:id="@+id/quick_tasks_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:fontFamily="sans-serif"
        android:text="TAP TO ADD TASKS"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="@dimen/widget_text_body"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/quick_task_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:button="@drawable/quick_task_check"
        android:background="?android:attr/selectableItemBackground"
        android:paddingStart="8dp"
        android:fontFamily="sans-serif"
        android:text="Reply to messages"
        android:textColor="@color/widget_on_surface"
        android:textSize="@dimen/widget_text_body"
        android:maxLines="1"
        android:ellipsize="end" />

    <CheckBox
        android:id="@+id/quick_task_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:button="@drawable/quick_task_check"
        android:background="?android:attr/selectableItemBackground"
        android:paddingStart="8dp"
        android:fontFamily="sans-serif"
        android:text="Pick up groceries"
        android:textColor="@color/widget_on_surface"
        android:textSize="@dimen/widget_text_body"
        android:maxLines="1"
        android:ellipsize="end"
        android:checked="true" />

    <CheckBox
        android:id="@+id/quick_task_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:button="@drawable/quick_task_check"
        android:background="?android:attr/selectableItemBackground"
        android:paddingStart="8dp"
        android:fontFamily="sans-serif"
        android:text="Plan tomorrow"
        android:textColor="@color/widget_on_surface"
        android:textSize="@dimen/widget_text_body"
        android:maxLines="1"
        android:ellipsize="end" />

    <CheckBox
        android:id="@+id/quick_task_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:button="@drawable/quick_task_check"
        android:background="?android:attr/selectableItemBackground"
        android:paddingStart="8dp"
        android:fontFamily="sans-serif"
        android:text="Charge headphones"
        android:textColor="@color/widget_on_surface"
        android:textSize="@dimen/widget_text_body"
        android:maxLines="1"
        android:ellipsize="end"
        android:checked="true" />
</LinearLayout>
