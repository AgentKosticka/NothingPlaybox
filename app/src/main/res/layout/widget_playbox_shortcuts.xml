<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/widget_card_background">

    <TextView
        android:id="@+id/shortcut_matrix"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:gravity="center"
        android:background="@drawable/widget_shortcut_button"
        android:fontFamily="NDot57"
        android:text="MATRIX"
        android:textColor="@color/widget_on_surface"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/shortcut_widgets"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:gravity="center"
        android:background="@drawable/widget_shortcut_button"
        android:fontFamily="NDot57"
        android:text="WIDGETS"
        android:textColor="@color/widget_on_surface"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/shortcut_aod"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:gravity="center"
        android:background="@drawable/widget_shortcut_button"
        android:fontFamily="NDot57"
        android:text="AOD TOY"
        android:textColor="@color/widget_accent"
        android:textSize="12sp" />
</LinearLayout>
