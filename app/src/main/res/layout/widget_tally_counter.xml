<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tally_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_background">

    <ImageView
        android:id="@+id/tally_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tally_minus"
            style="@style/Widget.Playbox.ControlLabel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="−"
            android:textSize="@dimen/widget_text_title" />

        <TextView
            android:id="@+id/tally_reset"
            style="@style/Widget.Playbox.ControlLabel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="RESET" />

        <TextView
            android:id="@+id/tally_plus"
            style="@style/Widget.Playbox.ControlLabel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="+"
            android:textSize="@dimen/widget_text_title" />
    </LinearLayout>
</LinearLayout>
