<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tally_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_background">
    <ImageView
        android:id="@+id/tally_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitXY" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center">
        <Button android:id="@+id/tally_minus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="−" android:textSize="18sp" />
        <Button android:id="@+id/tally_reset" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="RESET" android:textSize="10sp" />
        <Button android:id="@+id/tally_plus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="+" android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>