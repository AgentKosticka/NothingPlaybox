<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ndot_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="10dp"
    android:background="@drawable/widget_card_background">

    <TextClock
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:fontFamily="NDot57"
        android:textColor="@color/widget_on_surface"
        android:textSize="42sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="26sp"
        android:autoSizeMaxTextSize="58sp"
        android:autoSizeStepGranularity="2sp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm" />

    <TextClock
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:fontFamily="NDot57"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="13sp"
        android:format12Hour="EEE d MMM"
        android:format24Hour="EEE d MMM" />
</LinearLayout>
