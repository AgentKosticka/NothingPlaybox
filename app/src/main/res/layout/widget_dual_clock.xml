<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dual_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:background="@drawable/widget_card_background">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="NDot57"
            android:text="LOCAL"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:fontFamily="NDot57"
            android:textColor="@color/widget_on_surface"
            android:textSize="34sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="22sp"
            android:autoSizeMaxTextSize="42sp"
            android:autoSizeStepGranularity="2sp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="NDot57"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/dual_clock_remote_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="NDot57"
            android:text="UTC"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextClock
            android:id="@+id/dual_clock_remote_time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:fontFamily="NDot57"
            android:textColor="@color/widget_on_surface"
            android:textSize="34sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="22sp"
            android:autoSizeMaxTextSize="42sp"
            android:autoSizeStepGranularity="2sp"
            android:timeZone="UTC"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm" />

        <TextClock
            android:id="@+id/dual_clock_remote_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="NDot57"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:timeZone="UTC"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM" />
    </LinearLayout>
</LinearLayout>
