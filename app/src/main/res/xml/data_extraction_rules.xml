<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Only widget configuration is backed up; event records are never persisted. -->
        <include domain="sharedpref" path="widget-instances.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Only widget configuration is backed up; event records are never persisted. -->
        <include domain="sharedpref" path="widget-instances.xml" />
    </device-transfer>
</data-extraction-rules>
