<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:name=".PlayboxApplication"
        android:theme="@style/Theme.NothingPlaybox">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".widget.WidgetActionActivity" android:exported="false" android:theme="@android:style/Theme.NoDisplay" />
        <receiver android:name=".widget.AgendaWidget" android:exported="false" android:label="@string/agenda_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_widget" />
        </receiver>

        <receiver android:name=".widget.TimeBarsWidget" android:exported="false" android:label="@string/time_bars_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/time_bars_widget" />
        </receiver>

        <receiver android:name=".widget.DayDialWidget" android:exported="false" android:label="@string/day_dial_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/day_dial_widget" /></receiver>
        <receiver android:name=".widget.BatteryDotsWidget" android:exported="false" android:label="@string/battery_dots_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.ACTION_POWER_CONNECTED" /><action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" /><action android:name="android.intent.action.BATTERY_LOW" /><action android:name="android.intent.action.BATTERY_OKAY" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_dots_widget" /></receiver>
        <receiver android:name=".widget.BatteryGlyphWidget" android:exported="false" android:label="@string/battery_glyph_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_glyph_widget" /></receiver>
        <receiver android:name=".widget.BatteryColumnWidget" android:exported="false" android:label="@string/battery_column_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/battery_column_widget" /></receiver>
        <receiver android:name=".widget.WeekColumnWidget" android:exported="false" android:label="@string/week_column_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/week_column_widget" /></receiver>
        <receiver android:name=".widget.NextAlarmWidget" android:exported="false" android:label="@string/next_alarm_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/next_alarm_widget" /></receiver>
        <receiver android:name=".widget.StorageMatrixWidget" android:exported="false" android:label="@string/storage_matrix_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/storage_matrix_widget" /></receiver>
        <receiver android:name=".widget.MonthMatrixWidget" android:exported="false" android:label="@string/month_matrix_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/month_matrix_widget" /></receiver>
        <receiver android:name=".widget.WeekStripWidget" android:exported="false" android:label="@string/week_strip_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/week_strip_widget" /></receiver>
        <receiver android:name=".widget.YearDotsWidget" android:exported="false" android:label="@string/year_dots_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/year_dots_widget" /></receiver>
        <receiver android:name=".widget.DevicePanelWidget" android:exported="false" android:label="@string/device_panel_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/device_panel_widget" /></receiver>
        <receiver android:name=".widget.MilestoneWidget" android:exported="false" android:label="@string/milestone_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/milestone_widget" /></receiver>
        <receiver android:name=".widget.NDotClockWidget" android:exported="false" android:label="@string/ndot_clock_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/ndot_clock_widget" /></receiver>
        <receiver android:name=".widget.DualClockWidget" android:exported="false" android:label="@string/dual_clock_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/dual_clock_widget" /></receiver>
        <receiver android:name=".widget.PlayboxShortcutsWidget" android:exported="false" android:label="@string/playbox_shortcuts_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/playbox_shortcuts_widget" /></receiver>
        <receiver android:name=".widget.QuickTasksWidget" android:exported="false" android:label="@string/quick_tasks_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/quick_tasks_widget" /></receiver>

        <receiver android:name=".widget.HabitTrackerWidget" android:exported="false" android:label="@string/habit_tracker_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.DATE_CHANGED" /><action android:name="android.intent.action.TIMEZONE_CHANGED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/habit_tracker_widget" />
        </receiver>
        <receiver android:name=".widget.TallyCounterWidget" android:exported="false" android:label="@string/tally_counter_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/tally_counter_widget" /></receiver>
        <receiver android:name=".widget.PinnedNoteWidget" android:exported="false" android:label="@string/pinned_note_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/pinned_note_widget" /></receiver>

        <service android:name=".matrix.PlayboxToyService" android:exported="true" tools:ignore="ExportedService">
            <intent-filter><action android:name="com.nothing.glyph.TOY" /></intent-filter>
            <meta-data android:name="com.nothing.glyph.toy.name" android:resource="@string/toy_name" />
            <meta-data android:name="com.nothing.glyph.toy.summary" android:resource="@string/toy_summary" />
            <meta-data android:name="com.nothing.glyph.toy.image" android:resource="@drawable/toy_preview" />
            <meta-data android:name="com.nothing.glyph.toy.aod_support" android:value="1" />
        </service>
    </application>

</manifest>
